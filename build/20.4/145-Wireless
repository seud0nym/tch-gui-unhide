echo -e "[$SCRIPT]: Fix errant apostrophe"
sed \
  -e "s/RADIO'S/RADIOS/" \
  -i /www/docroot/modals/wireless-radio.lp

if grep -q '^        local allowed_channels_5G = list5g\[content\["channelwidth"\]\] or list5g\["auto"\]$' /www/docroot/modals/wireless-radio.lp \
&& grep -q '^        if multiap_Enabled then table.insert(allowed_channels_5G,1,{"0","Auto"}) else table.insert(allowed_channels_5G,1,{"auto","Auto"}) end$' /www/docroot/modals/wireless-radio.lp \
&& ! grep -q 'configured_channel' /www/docroot/modals/wireless-radio.lp; then
  echo -e "[$SCRIPT]: Fix 5GHz channel being reset to Auto on save"
  sed \
    -e '/^        if multiap_Enabled then table.insert(allowed_channels_5G,1,{"0","Auto"}) else table.insert(allowed_channels_5G,1,{"auto","Auto"}) end$/a\
        -- The list for each channel width offers only some primary channels (36 52 100 132 149 at 80MHz),\
        -- but any allowed channel can be configured. If the configured channel is missing, the select\
        -- shows Auto and the next save writes it, so add it to a copy of the list.\
        local configured_channel = untaint(content["requested_channel"] or "")\
        local channels,listed = {},configured_channel == ""\
        for i,v in ipairs(allowed_channels_5G) do\
          channels[i] = v\
          listed = listed or untaint(v[1]) == configured_channel\
        end\
        if not listed then\
          local number,pos = tonumber(configured_channel),#channels+1\
          for i=#channels,2,-1 do\
            if number and tonumber(channels[i][1]) and tonumber(channels[i][1]) > number then\
              pos = i\
            end\
          end\
          local label = configured_channel\
          if number and number >= 52 and number <= 144 then\
            label = label.."(DFS)"\
          end\
          table.insert(channels,pos,{configured_channel,label})\
        end\
        allowed_channels_5G = channels' \
    -i /www/docroot/modals/wireless-radio.lp
fi

echo -e "[$SCRIPT]: Fix Guest Split SSID when running as EasyMesh Agent role"
sed \
  -e '/ui_helper.createSwitch(T"Split"/a\      else ngx.print(ui_helper.createSimpleInputHidden("split_ssid",split_ssid,{input={id="split_ssid"}}))' \
  -i /www/docroot/modals/wireless-modal.lp

echo -e "[$SCRIPT]: Fix bug when changing WiFi password on single SSID"
sed \
  -e 's/wpa_pskwl1:"wpa_pskwl1",/wpa_pskwl1:"wpa_pskwl0",/' \
  -i /www/docroot/modals/wireless-modal.lp

echo -e "[$SCRIPT]: Add switch to modify AP Isolation"
sed \
 -e '/mapParams\["ap_broadcast_ssid"..curap\]/a\    mapParams["ap_isolation"..curap] = "rpc.wireless.ap.@" .. curap ..".ap_isolation"' \
 -e '/mapValid\["ap_broadcast_ssid"..curap\]/a\    mapValid["ap_isolation"..curap] = validateBoolean' \
 -e '/setTable\["rpc.wireless.ap.@"..mergeAP..".public"\]/a\          setTable["rpc.wireless.ap.@"..mergeAP..".ap_isolation"] = postargs["ap_isolation"..ap]' \
 -e '/T"\(Broadcast\|Hide\) SSID"/a\    html[#html + 1] = ui_helper.createSwitch(T"AP Isolation", "ap_isolation"..curap, content["ap_isolation"..curap], advanced)' \
 -i /www/docroot/modals/wireless-modal.lp

if [ "$MINIFY" = y ]; then
  echo -e "[$SCRIPT]: Pre-minify fixes"
  [ -n "$VERBOSE" ] && echo -e "[$SCRIPT]: - Fixing /www/docroot/modals/wireless-modal.lp"
  sed \
    -e 's/\(function loadACLList\)/;\1/' \
    -e 's/\(function get_status_acl\)/;\1/' \
    -e 's/\(var curap = aplists\[ap\]\)/\1;/' \
    -e 's/\(var apVal = ap_list\[ap\]\)/\1;/' \
    -e 's/\(var params = {}\)/\1;/' \
    -e 's/\(var wpapsk_id_exists = \$("#"+wpapsk)\)/\1;/' \
    -e 's/\(var wpa3_id_exists = \$("#"+wpa3)\)/\1;/' \
    -e 's/\(var wep_id_exists = \$("#"+wep)\)/\1;/' \
    -e 's/\(var credPwd_id_exists =\$("#"+credPwd)\)/\1;/' \
    -i /www/docroot/modals/wireless-modal.lp
fi
