echo -e "[$SCRIPT]: Fix spelling in WiFi error message"
sed \
 -e 's/Mac address/MAC Address/' \
 -i /www/docroot/modals/wireless-modal.lp

echo -e "[$SCRIPT]: Add WiFi QR Code button"
sed \
  -e '/isguest ~= "1" and \(\(isExtRemman  ~= "1"\)\|isRadiusIncluded\)/i\    local not_security_none = {\
        button = {\
          id = "btn-qrcode"\
        },\
        group = {\
          class ="monitor-security monitor-wep monitor-wpa-psk monitor-wpa2-psk monitor-wpa-wpa2-psk monitor-wpa3 monitor-wpa3-psk monitor-wpa2-wpa3 monitor-wpa2-wpa3-psk",\
        },\
     }\
     html[#html+1] = ui_helper.createButton("QR Code","Show","icon-print",not_security_none)\
     html[#html+1] = format("<script>$(\\"#btn-qrcode\\").click(function(){tch.loadModal(\\"/modals/wireless-qrcode-modal.lp?iface=%s&ap=%s\\");})</script>",curiface,curap)' \
  -i /www/docroot/modals/wireless-modal.lp

if [ "$MINIFY" = y ]; then
  echo -e "[$SCRIPT]: Pre-minify fixes"
  [ -n "$VERBOSE" ] && echo -e "[$SCRIPT]: - Fixing /www/docroot/modals/wireless-modal.lp"
  sed \
    -e 's/\(if *(bandLockState\)/;\1/' \
    -e 's/\(Class("tooltipEnabled")\)/\1;/' \
    -e 's|content["phy_rate"] / 1000|(content["phy_rate"]/1000)|' \
    -i /www/docroot/modals/wireless-modal.lp
  [ -n "$VERBOSE" ] && echo -e "[$SCRIPT]: - Fixing /www/docroot/modals/wireless-client-modal.lp"
  sed \
    -e 's/\(var timerajax\)\(\\\)/\1;\2/' \
    -e 's/\(var gets =  {}\)\(\\\)/\1;\2/' \
    -e 's/\(var x = parseInt(x) \* -1\)\(\\\)/\1;\2/' \
    -e 's/\(var \$d = \$("#bar-"+countwifi)\)\(\\\)/\1;\2/' \
    -e "s|//left: \\\\'5px\\\\'||" \
    -i /www/docroot/modals/wireless-client-modal.lp
fi

if [ $(uci -q show network | grep -E '\.Guest.*=interface' | wc -l) -eq 0 ]; then
  echo -e "[$SCRIPT]: Fixed Basic view Wi-Fi tabs when Guest Wi-Fi removed"
  sed -e '/^--check whether the.*guest1 exists/,/^$/d' -i /www/snippets/tabs-wifi.lp
fi

echo -e "[$SCRIPT]: Change transformer mapping to allow modification of AP Isolation"
sed \
 -e '/ap_isolation/{n; s/Only/Write/}' \
 -i /usr/share/transformer/mappings/rpc/wireless.ap.map

if grep -q '^local secmodes = {}$' /www/docroot/modals/wireless-modal.lp \
&& grep -q '^local content, helpmsg = post_helper.handleQuery(mapParams, mapValid)$' /www/docroot/modals/wireless-modal.lp \
&& grep -q 'security = gVIES(secmodes),' /www/docroot/modals/wireless-modal.lp \
&& ! grep -q 'current_security' /www/docroot/modals/wireless-modal.lp; then
  echo -e "[$SCRIPT]: Fix Wi-Fi security mode falling back to None when the current mode is not offered"
  sed \
    -e '/^local content, helpmsg = post_helper.handleQuery(mapParams, mapValid)$/i\
-- Always list the current security mode of the access point. If it is missing (WEP is not offered on 20.3.c), the\
-- select shows the first entry (None), and the next save would turn the access point into an open network.\
-- Legacy modes that the firmware offers stay available for older devices, labelled as such.\
do\
  local legacy_modes = {\
    ["wep"] = T"WEP (not recommended)",\
    ["wpa-psk"] = T"WPA PSK (TKIP)",\
    ["wpa-wpa2-psk"] = T"WPA+WPA2 PSK (TKIP)",\
    ["wpa"] = T"WPA (TKIP)",\
    ["wpa-wpa2"] = T"WPA+WPA2 (TKIP)",\
  }\
  local current_security = mapParams["security"] and proxy.get(mapParams["security"])\
  current_security = current_security and current_security[1] and untaint(current_security[1].value) or ""\
  local listed = current_security == ""\
  for _,v in ipairs(secmodes) do\
    if v[1] == current_security then\
      listed = true\
    end\
    if legacy_modes[v[1]] then\
      v[2] = legacy_modes[v[1]]\
    end\
  end\
  if not listed then\
    secmodes[#secmodes+1] = { current_security, legacy_modes[current_security] or T(string.upper(current_security)) }\
  end\
end' \
    -e '/createAlertBlock(T"WEP is known to be flawed as a wireless security mode, usage of a more secure mode based on WPA2 is recommended.",wep_warning)$/a\
        local tkip_warning = {\
            alert = {\
                class = "alert-error monitor-security monitor-wpa-psk monitor-wpa-wpa2-psk monitor-wpa monitor-wpa-wpa2"\
            },\
        }\
        html[#html + 1] = ui_helper.createAlertBlock(T"TKIP, used by WPA and allowed by WPA+WPA2, is deprecated, less secure and limits Wi-Fi speed. Use it only for devices that do not support WPA2. WPA2 PSK is recommended.",tkip_warning)' \
    -i /www/docroot/modals/wireless-modal.lp
fi
